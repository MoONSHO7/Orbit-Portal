package-as: Orbit_Portal

externals:
  # LibOrbitUI release 1.8 provides API 1.10; pin its verified release commit.
  Libs/LibOrbitUI-1.0:
    url: https://github.com/MoONSHO7/Orbit-Libs
    commit: bcdf20687b3555fac7078b1bf044104fb8db167e
    path: LibOrbitUI/LibOrbitUI-1.0

ignore:
  - .git
  - .github
  - .vscode
  - .scripts
  - "**/*.md"
  - .stylua.toml
  - .styluaignore
  - .env
