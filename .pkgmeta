package-as: Orbit_Portal

externals:
  # LibOrbitUI release 1.3 provides API 1.8; pin its verified release commit.
  Libs/LibOrbitUI-1.0:
    url: https://github.com/MoONSHO7/Orbit-Libs
    commit: 6c5fca4c663272a8b9123bdfad087c66750e4c1a
    path: LibOrbitUI/LibOrbitUI-1.0

ignore:
  - .git
  - .github
  - .vscode
  - .scripts
  - "**/*.md"
  - .stylua.toml
  - .styluaignore
  - .env
