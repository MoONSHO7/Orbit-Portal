package-as: Orbit_Portal

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

externals:
  # LibOrbitUI release 1.17 provides API 1.18; pin its verified release commit.
  Libs/LibOrbitUI-1.0:
    url: https://github.com/MoONSHO7/Orbit-Libs
    commit: 88f6eade91f0a3bfaf0c6ab8ad23b354651453e1
    path: LibOrbitUI/LibOrbitUI-1.0

ignore:
  - .git
  - .github
  - .vscode
  - .scripts
  - "**/*.md"
  - .stylua.toml
  - .styluaignore
  - .env
