package-as: Orbit_Portal

externals:
  # LibOrbitUI release 1.5 provides API 1.8; pin its verified release commit.
  Libs/LibOrbitUI-1.0:
    url: https://github.com/MoONSHO7/Orbit-Libs
    commit: 633ae7ace624fd46128c102226e1985dee550041
    path: LibOrbitUI/LibOrbitUI-1.0

ignore:
  - .git
  - .github
  - .vscode
  - .scripts
  - "**/*.md"
  - .stylua.toml
  - .styluaignore
  - .env
