package-as: Orbit_Portal

externals:
  # LibOrbitUI release 1.6 provides API 1.8; pin its verified release commit.
  Libs/LibOrbitUI-1.0:
    url: https://github.com/MoONSHO7/Orbit-Libs
    commit: 10bc9ae8d0f8db886549d59c3547da4af64b3245
    path: LibOrbitUI/LibOrbitUI-1.0

ignore:
  - .git
  - .github
  - .vscode
  - .scripts
  - "**/*.md"
  - .stylua.toml
  - .styluaignore
  - .env
